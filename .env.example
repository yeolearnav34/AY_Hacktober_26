# ==========================================================
# CropCare AI — Environment Configuration Template
# All keys here use placeholder values.
# Copy this file to .env or .env.local and add your real keys.
# ==========================================================

# 1. Supabase Backend & Edge Function Configuration (Optional for Cloud Sync)
# Get these from your Supabase Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# 2. AI Crop Disease Inference Model Endpoint (Optional)
# If left blank, CropCare AI automatically runs with high-precision client-side
# canvas feature segmentation and the verified Indian agronomic knowledge engine.
# Recommended Hugging Face plant models:
# - linkanjarad/mobilenet_v2_1.0_224-plant-disease-identification
# - nateraw/vit-base-patch16-224-crop-disease
VITE_HUGGINGFACE_API_KEY=hf_your_huggingface_token_here
VITE_HF_MODEL=linkanjarad/mobilenet_v2_1.0_224-plant-disease-identification

# 3. Weather Service (Optional)
# If left blank, CropCare AI automatically connects to Open-Meteo's live satellite
# weather API (zero API key required) for real-time agricultural advisories.
VITE_OPENWEATHER_API_KEY=your_openweather_api_key_here

# 4. Trained plant disease model API (see model-api/README.md)
# URL of your deployed model server, e.g. https://your-name-cropcare-model.hf.space
# If blank, the site uses its built-in engine instead.
VITE_MODEL_API_URL=
